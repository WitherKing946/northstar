# Copy to .env and adjust. Everything is overridable at deploy time.
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./northstar.db
# Supabase (hosted Postgres) — paste your Supabase pooled connection string:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Alternative forms auto-converted: postgres:// and postgresql://
PORT=8000

# Embedded AI is default; set one of these to enable live LLM (grounded on the skill graph)
LLM_MODEL=embedded
OLLAMA_BASE_URL=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT=30

# Frontend Supabase (optional, for direct sync)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=