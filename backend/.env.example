# Copy to .env and adjust. Everything is overridable at deploy time.
DATABASE_URL=sqlite:///./northstar.db
PORT=8000

# AI provider: Groq (hosted cloud). Requires a Groq API key.
# Get one at https://console.groq.com/keys and paste it as GROQ_API_KEY below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=60

# Frontend Supabase (optional, for direct sync)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=